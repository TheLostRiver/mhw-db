// Cloudflare Workers 静态资源部署：pnpm run deploy（先构建，再上传 site/dist）
// 游戏图片（site/public/assets/game/）不入库，由本机管线生成后随构建产物一起上传。
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mhw-db",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./site/dist",
    "not_found_handling": "404-page",
  },
  // 只通过自定义域名访问，不开 workers.dev 与预览地址
  "routes": [{ "pattern": "mhdb.helsincy.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
}
