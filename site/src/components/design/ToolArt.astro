  tree: `
    <circle cx="8" cy="33" r="4"/>
    <path d="M12 33h22M34 33c10 0 10-18 22-18h14M34 33c10 0 10 18 22 18h14M70 15h14c8 0 8-9 16-9h12M70 15h14c8 0 8 9 16 9h12M70 51h42"/>
    <circle cx="34" cy="33" r="3" fill="currentColor"/><circle cx="70" cy="15" r="3" fill="currentColor"/><circle cx="70" cy="51" r="3"/>
    <circle cx="116" cy="6" r="3"/><circle cx="116" cy="24" r="3"/><circle cx="116" cy="51" r="3" fill="currentColor"/>`,
  dice: `
    <path d="M6 60h120"/>
