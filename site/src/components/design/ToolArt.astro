};
---

<svg
  class={className}
  width={width}
  viewBox="0 0 130 66"
  fill="none"
  stroke="currentColor"
  stroke-width="1.4"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={art[name]}
/>
