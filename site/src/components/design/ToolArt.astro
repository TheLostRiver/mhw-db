  calendar: `
    <rect x="4" y="8" width="118" height="54" rx="2"/><path d="M4 20h118"/>
    <path d="M21 20v42M38 20v42M55 20v42M72 20v42M89 20v42M106 20v42M4 34h118M4 48h118"/>
    <circle cx="80" cy="41" r="9" stroke-width="2"/>`,
  monster: `
    <circle cx="22" cy="33" r="10"/>
    <path d="M15 27l12 12M18 24l12 12M14 32l8 8" stroke-width="1"/>
