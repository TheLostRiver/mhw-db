---
/** 三态主题切换（跟随系统 / 浅色 / 深色）。外观由各视觉方向的 .theme-toggle 样式决定。 */
import Icon from './Icon.astro';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const options = [
  { value: 'system', label: '跟随系统', icon: 'monitor' },
  { value: 'light', label: '浅色', icon: 'sun' },
  { value: 'dark', label: '深色', icon: 'moon' },
] as const;
---

<div class:list={['theme-toggle', className]} role="radiogroup" aria-label="颜色主题">
  {options.map((o) => (
    <button type="button" role="radio" data-theme-value={o.value} aria-label={o.label} title={o.label}>
      <Icon name={o.icon} size={15} />
    </button>
  ))}
</div>

<script>
  type ThemeApi = { set(pref: string): void };
  const sync = () => {
    const pref = document.documentElement.dataset.themePref ?? 'system';
    document.querySelectorAll<HTMLButtonElement>('.theme-toggle [data-theme-value]').forEach((b) => {
      b.setAttribute('aria-checked', String(b.dataset.themeValue === pref));
    });
  };
  document.querySelectorAll<HTMLButtonElement>('.theme-toggle [data-theme-value]').forEach((b) => {
    b.addEventListener('click', () => {
      (window as unknown as { __mhdbTheme: ThemeApi }).__mhdbTheme.set(b.dataset.themeValue ?? 'system');
      sync();
    });
  });
  sync();
</script>
