  arms: '<path d="M7 4h6.5l1 6 4.5 2.2v5.3L16 20.5H9.5L7 15Z"/><path d="M7.5 9.5h6.8"/>',
  waist: '<path d="M3.5 8.5h17v4h-17Z"/><path d="M10 8.5v4M7.5 12.5 6 20M16.5 12.5 18 20M12 12.5v5"/>',
