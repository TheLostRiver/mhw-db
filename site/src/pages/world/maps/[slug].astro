---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import MapViewer from '../../../islands/map/MapViewer';
import { loadItems, loadMapNodes, loadMaps } from '../../../data/world/load';
import type { MapNodeStage, MapStage } from '../../../data/world/schema';
import { stageSlug } from '../../../lib/world/maps';
import { stageEmblemUrl, type MapItems } from '../../../lib/world/mapNodes';

export function getStaticPaths() {
  const nodes = new Map(loadMapNodes().map((s) => [s.id, s]));
  const items = loadItems();
  return loadMaps().map((stage) => {
    const st = nodes.get(stage.id) ?? null;
    // 只把这张图用到的物品（固定物品、抽选表里的物品、钓点的鱼）交给地图岛
    const used = new Set<number>();
    for (const k of st?.kinds ?? []) if (k.item !== null) used.add(k.item);
    for (const n of st?.nodes ?? []) for (const f of n.fish ?? []) used.add(f);
    for (const rows of Object.values(st?.lots ?? {}))
      for (const e of Object.values(rows).flat()) used.add(e.item);
    const subset: MapItems = Object.fromEntries(
      items
        .filter((i) => used.has(i.id))
        .map((i) => [i.id, { name: i.name['zh-Hans'], icon: i.icon.id, color: i.icon.color }]),
    );
    return { params: { slug: stageSlug(stage) }, props: { stage, nodes: st, items: subset } };
  });
}

interface Props {
  stage: MapStage;
  nodes: MapNodeStage | null;
  items: MapItems;
}

const { stage, nodes, items } = Astro.props;
const areaCount = new Set(stage.patches.map((p) => p.area)).size;
const nodeCount = nodes?.nodes.filter((n) => n.layer !== null).length ?? 0;
---

<SiteLayout title={`${stage.name['zh-Hans']} · 地图`} current="maps" wide>
  <nav class="crumbs b-label" aria-label="位置">
    <a href="/world/maps/">地图</a>
    <span aria-hidden="true">/</span>
    <span>{stage.name['zh-Hans']}</span>
  </nav>
  <div class="page-head">
    <h1>
      <span class="emblem" style={`--emblem: url('${stageEmblemUrl(stage.id)}')`} aria-hidden="true" />
      {stage.name['zh-Hans']}
      {stage.name.en && <span class="b-label">{stage.name.en}</span>}
    </h1>
    <p>
      {areaCount} 个区域{stage.layers > 1 && `，分 ${stage.layers} 层`}
      {nodeCount > 0 && `，${nodeCount} 个节点`}
      。滚轮或双指缩放，拖动平移；点标记查看采集物与概率{stage.layers > 1 && '，地图左上角切换楼层'}。
    </p>
  </div>
  <MapViewer client:only="react" stage={stage} nodes={nodes} items={items} />
</SiteLayout>

<style>
  .crumbs {
    display: flex;
    gap: var(--space-2);
    margin-bottom: var(--space-2);
  }

  .crumbs a {
    color: var(--c-text-2);
  }

  .page-head {
    margin-bottom: var(--space-4);
  }

  .emblem {
    align-self: center;
    width: 40px;
    height: 40px;
    flex: none;
    background: var(--c-text);
    -webkit-mask: var(--emblem) center / contain no-repeat;
    mask: var(--emblem) center / contain no-repeat;
  }

  .page-head h1 {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    font-size: var(--text-2xl);
    font-weight: 800;
  }

  .page-head p {
    margin-top: var(--space-1);
    color: var(--c-text-2);
  }
</style>
