const ready = chapters.reduce((n, c) => n + c.entries.filter((e) => e.href).length, 0);
const total = chapters.reduce((n, c) => n + c.entries.length, 0);
const stats = [
  { label: '怪物', value: monsters.length },
  { label: '武器', value: weapons.length },
  { label: '防具', value: loadArmor().length },
  { label: '技能', value: loadSkills().length },
  { label: '道具', value: items.length },
];
const lines = contours({ width: 1600, height: 640, peaks: 4, rings: 12, seed: 23 });
let no = 0;
---

<SiteLayout
  title="百科"
  current="encyclopedia"
  description="怪物猎人：世界 冰原 资料百科：怪物、地图、武器、招式、防具、技能、道具、调和、任务、设施与机制数值"
  wide
>
  <section class="ec-hero">
    <svg
      class="ec-hero__lines"
      viewBox="0 0 1600 640"
      preserveAspectRatio="xMidYMid slice"
      aria-hidden="true"
    >
      {lines.map((d) => (
        <path d={d} />
      ))}
    </svg>
    <span class="ec-hero__glyph" aria-hidden="true">
      鉴
    </span>
    <div class="ec-hero__copy">
      <p class="ec-kicker">
        <span>Archive</span>新大陆调查团 · 资料馆
      </p>
      <h1>
        百科
        <small>
          {ready} / {total} 类已整理
        </small>
      </h1>
      <p class="ec-lead">
        数值与文本全部由本站从游戏文件解包整理，简体中文为游戏内文本；每页底部注明来源文件，
        推断或未确认的字段会在页面上标出。
      </p>
      <label class="ec-search">
        <span class="sr-only">查找资料</span>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="11" cy="11" r="6.5"></circle>
          <path d="m16 16 4.5 4.5"></path>
        </svg>
        <input type="search" placeholder="查找资料：怪物、调和、猎虫……" data-ec-search />
        <kbd aria-hidden="true">/</kbd>
      </label>
      <p class="ec-search__count" aria-live="polite" data-ec-count></p>
    </div>
    <dl class="ec-stats">
      {stats.map((s) => (
        <div>
          <dt>{s.label}</dt>
          <dd>{s.value.toLocaleString('en-US')}</dd>
        </div>
      ))}
    </dl>
  </section>

  <div class="ec-body">
    <nav class="ec-rail" aria-label="章节">
      <ol>
        {chapters.map((c) => (
          <li>
            <a href={`#ch-${c.key}`} style={`--hue: ${c.hue}`} data-ec-rail={c.key}>
              <span class="ec-rail__num">{c.numeral}</span>
              <span>{c.title}</span>
            </a>
          </li>
        ))}
      </ol>
    </nav>

    <div class="ec-chapters">
      {chapters.map((c) => (
        <section class="ec-ch" id={`ch-${c.key}`} style={`--hue: ${c.hue}`} data-ec-chapter={c.key}>
          <header class="ec-ch__head">
            <span class="ec-ch__num" aria-hidden="true">
              {c.numeral}
            </span>
            <div>
              <p class="ec-ch__en">{c.en}</p>
              <h2>{c.title}</h2>
              <p class="ec-ch__lead">{c.lead}</p>
            </div>
          </header>
          <ul class="ec-grid">
            {c.entries.map((e) => {
              no += 1;
              const body = (
                <>
                  <span class="ec-card__no">{String(no).padStart(2, '0')}</span>
                  <span class="ec-seal" aria-hidden="true">
                    <svg viewBox="0 0 64 64">
                      <circle class="ec-seal__ring" cx="32" cy="32" r="29" />
                      <circle class="ec-seal__dash" cx="32" cy="32" r="24.5" />
                    </svg>
                    <i class="ec-glyph" style={`--glyph: url(${G}/glyph/${e.glyph}.webp)`} />
                  </span>
                  <strong>{e.label}</strong>
                  <small>{e.note}</small>
                  {e.count != null ? (
                    <span class="ec-card__count">{e.count.toLocaleString('en-US')}</span>
                  ) : (
                    !e.href && <span class="ec-card__todo">整理中</span>
                  )}
                </>
              );
              return (
                <li data-ec-entry data-text={`${e.label} ${e.note} ${c.title}`.toLowerCase()}>
                  {e.href ? (
                    <a class="ec-card" href={e.href}>
                      {body}
                    </a>
                  ) : (
                    <div class="ec-card is-todo" aria-disabled="true">
                      {body}
                    </div>
                  )}
                </li>
              );
            })}
          </ul>
        </section>
      ))}
      <p class="ec-empty" hidden data-ec-empty>
        没有匹配的类别。
      </p>
    </div>
  </div>
</SiteLayout>

<script>
  const input = document.querySelector<HTMLInputElement>('[data-ec-search]');
  const count = document.querySelector<HTMLElement>('[data-ec-count]');
  const empty = document.querySelector<HTMLElement>('[data-ec-empty]');
  const entries = [...document.querySelectorAll<HTMLElement>('[data-ec-entry]')];
  const chapters = [...document.querySelectorAll<HTMLElement>('[data-ec-chapter]')];

  input?.addEventListener('input', () => {
    const q = input.value.trim().toLowerCase();
    let shown = 0;
    for (const e of entries) {
      const hit = !q || (e.dataset.text ?? '').includes(q);
      e.hidden = !hit;
      if (hit) shown++;
    }
    for (const c of chapters) c.hidden = !c.querySelector('[data-ec-entry]:not([hidden])');
    if (count) count.textContent = q ? `${shown} 类匹配` : '';
    if (empty) empty.hidden = shown > 0;
  });

  // 「/」聚焦搜索框（输入框里不拦截）
  document.addEventListener('keydown', (e) => {
    if (e.key !== '/' || e.ctrlKey || e.metaKey || e.altKey) return;
    const t = e.target as HTMLElement | null;
    if (t && (t.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName))) return;
    e.preventDefault();
    input?.focus();
  });

  // 章节索引随滚动高亮
  const rail = new Map(
    [...document.querySelectorAll<HTMLElement>('[data-ec-rail]')].map((a) => [a.dataset.ecRail!, a]),
  );
  const io = new IntersectionObserver(
    (list) => {
      for (const it of list) {
        if (!it.isIntersecting) continue;
        const key = (it.target as HTMLElement).dataset.ecChapter!;
        for (const [k, a] of rail) a.toggleAttribute('aria-current', k === key);
      }
    },
    { rootMargin: '-35% 0px -60% 0px' },
  );
  chapters.forEach((c) => io.observe(c));
</script>

<style>
  /* ---------- 题头 ---------- */
  .ec-hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: var(--space-8);
    margin: calc(var(--space-5) * -1) calc(var(--space-5) * -1) var(--space-8);
    padding: var(--space-16) var(--space-8) var(--space-10);
    overflow: hidden;
    isolation: isolate;
    border-bottom: 1px solid var(--c-line);
    background:
      radial-gradient(
        80% 120% at 85% 10%,
        color-mix(in oklab, var(--c-accent) 10%, transparent),
        transparent 60%
      ),
      radial-gradient(60% 90% at 0% 100%, rgb(224 119 63 / 0.08), transparent 70%), var(--c-bg);
  }

  .ec-hero__lines {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    fill: none;
    stroke: color-mix(in oklab, var(--c-accent) 16%, transparent);
    stroke-width: 1;
    mask-image: linear-gradient(90deg, transparent, #000 30%, #000 80%, transparent);
  }

  .ec-hero__glyph {
    position: absolute;
    right: 4%;
    top: 50%;
