---
/**
 * 百科目录「调查资料馆」：九个章节，每章一种色调；卡片是档案标签（编号、徽记、名称、条目数）。
 * 顶部搜索可跨章节筛选，左侧章节索引随滚动高亮。尚未整理完的类别以「整理中」标出，不可点击。
 */
import SiteLayout from '../../../layouts/SiteLayout.astro';
import {
  loadArgosy,
  loadArmor,
  loadBotany,
  loadBounties,
  loadCanteen,
  loadCharms,
  loadCombinations,
  loadDecorations,
  loadDeliveries,
  loadItems,
  loadKinsects,
  loadLayeredWeapons,
  loadMantles,
  loadMaps,
  loadMelder,
  loadMelodies,
  loadMonsters,
  loadMoves,
  loadPalicoGear,
  loadPendants,
  loadQuests,
  loadRecords,
  loadShop,
  loadSkills,
  loadWeaponCustom,
  loadWeapons,
} from '../../../data/world/load';
import { WEAPON_TYPES } from '../../../data/world/schema';
import { contours } from '../../../lib/contours';
import { ITEM_TYPES } from '../../../lib/world/encyclopedia';

const G = '/assets/game/world';
const items = loadItems();
const weapons = WEAPON_TYPES.flatMap((t) => loadWeapons(t).filter((w) => w.duplicateOf == null));
const monsters = loadMonsters().filter((m) => m.name);
const combos = loadCombinations();
const ITEM_GLYPH: Record<string, string> = {
  consumables: 'item',
  materials: 'material',
  other: 'other',
  ammo: 'ammo',
  room: 'room',
};
const custom = loadWeaponCustom();
const records = loadRecords();

interface Entry {
  label: string;
  note: string;
  /** glyph/ 下的单色图形名，按章节色着色 */
  glyph: string;
  href?: string;
  count?: number;
}
interface Chapter {
  key: string;
  numeral: string;
  title: string;
  en: string;
  hue: string;
  lead: string;
  entries: Entry[];
}

const chapters: Chapter[] = [
