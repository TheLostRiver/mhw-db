---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import { loadItems, loadLayeredArmor, loadSchedule } from '../../../data/world/load';
import type { Schedule } from '../../../data/world/schema-records';
import { itemIconUrl } from '../../../lib/world/encyclopedia';

const { weeks, star, moon } = loadSchedule();
type Season = Schedule['star'][number]['season'];
const HUE: Record<Season, string> = {
  spring: '#e98bb0',
  summer: '#3fb6c9',
  autumn: '#e08a3c',
  winter: '#8fb4ff',
  memorial: '#e0b84f',
};
// 蒸气机关是冰原的设施，只给月辰祭挂奖励表
const STEAM_TABLE: Record<Season, string> = {
  spring: '盛放之宴',
  summer: '热情之宴',
  autumn: '秋季',
  winter: '万福之宴',
  memorial: '大感谢之宴',
};
const byId = new Map(star.map((f) => [f.id, f]));

// 年轮：53 周平分一圈，从顶部顺时针
const C = 210;
const R0 = 148;
const R1 = 190;
const STEP = (Math.PI * 2) / weeks.length;
const pt = (r: number, a: number) =>
  `${(C + r * Math.cos(a)).toFixed(2)} ${(C + r * Math.sin(a)).toFixed(2)}`;
const arc = (i: number) => {
  const a0 = -Math.PI / 2 + i * STEP + 0.006;
  const a1 = a0 + STEP - 0.012;
  return `M ${pt(R1, a0)} A ${R1} ${R1} 0 0 1 ${pt(R1, a1)} L ${pt(R0, a1)} A ${R0} ${R0} 0 0 0 ${pt(R0, a0)} Z`;
};
// 月份刻度：按 365 天均分到 53 周的位置（只是估算，周与日期的对应未确认）
const MONTH_DAYS = [0, 31, 59, 90, 120, 151, 181, 212, 243, 273, 304, 334];
const months = MONTH_DAYS.map((d, m) => {
  const a = -Math.PI / 2 + (d / 365) * Math.PI * 2;
  return { m: m + 1, tick: [pt(R1 + 4, a), pt(R1 + 12, a)], label: pt(R1 + 24, a) };
});

// 每个祭典占的周（连续的合并成区间）
const ranges = (id: number) => {
  const list = weeks.filter((w) => w.festival === id).map((w) => w.week);
  const out: [number, number][] = [];
  for (const w of list) {
    const last = out.at(-1);
    if (last && last[1] === w - 1) last[1] = w;
    else out.push([w, w]);
  }
  return out.map(([a, b]) => (a === b ? `${a}` : `${a}–${b}`)).join('、');
};

// 祭典票：说明里写着「【xx之宴】」、名字以「票」结尾的物品；再找用这张票生产的幻化服装系列
const items = loadItems();
const layered = loadLayeredArmor();
const inner = (name: string) => /【(.+?)】/.exec(name)?.[1] ?? name;
const ticketsOf = (name: string) =>
  items.filter(
    (i) => i.name['zh-Hans'].endsWith('票') && (i.desc['zh-Hans'] ?? '').includes(`【${inner(name)}】`),
  );
const seriesOf = (ticket: number) => [
  ...new Set(
    layered
      .filter((a) => a.materials.some((m) => m.item === ticket))
      .map((a) => a.series.name['zh-Hans'] ?? ''),
  ),
];
const festivals = [
  ...star.map((f) => ({ ...f, kind: '星辰祭' as const, weeks: ranges(f.id) })),
  ...moon.map((f) => ({ ...f, id: 0, kind: '月辰祭' as const, weeks: '' })),
].map((f) => ({
  ...f,
  tickets: ticketsOf(f.name['zh-Hans']).map((t) => ({ item: t, series: seriesOf(t.id) })),
}));
---

<SiteLayout
  title="祭典与日历"
  current="encyclopedia"
  description="怪物猎人：世界 冰原 星辰祭 / 月辰祭：游戏内置的年度祭典日程（按周）、各祭典的票券与可生产的幻化服装"
  wide
>
  <nav class="s-crumbs" aria-label="位置">
    <a href="/world/encyclopedia/">百科</a>
    <span>祭典与日历</span>
  </nav>
  <div class="s-head">
    <h1>祭典与日历</h1>
    <p>
      集会区域的季节祭典：本体的「星辰祭」五个、冰原的「月辰祭」四个。下面的年轮是游戏数据里内置的一年 53
      周日程。
    </p>
  </div>

  <section class="fe-wheel" aria-labelledby="fe-wheel-title">
    <figure>
      <svg viewBox="-24 -24 468 468" role="img" aria-labelledby="fe-wheel-title fe-wheel-desc">
        <title id="fe-wheel-title">星辰祭年度日程</title>
        <desc id="fe-wheel-desc">一年 53 周，从顶部顺时针排列，有颜色的周是祭典期间。</desc>
        <circle cx={C} cy={C} r={R0 - 14} class="fe-core" />
        {months.map((m) => (
          <g class="fe-month">
            <path d={`M ${m.tick[0]} L ${m.tick[1]}`} />
            <text
              x={m.label.split(' ')[0]}
              y={m.label.split(' ')[1]}
              text-anchor="middle"
              dominant-baseline="central"
            >
              {m.m}月
            </text>
          </g>
        ))}
        {weeks.map((w, i) => {
          const f = byId.get(w.festival);
          return (
            <path
              d={arc(i)}
              class:list={['fe-seg', { 'fe-seg--fes': f }]}
              style={`${f ? `--hue: ${HUE[f.season]};` : ''} --i: ${i}`}
              data-week={w.week}
            >
              <title>
                第 {w.week} 周：{f ? f.name['zh-Hans'] : '平时'}（轮换编号 {w.rotation}）
              </title>
            </path>
          );
        })}
        <text x={C} y={C - 12} text-anchor="middle" class="fe-core-title">
          星辰祭
        </text>
        <text x={C} y={C + 14} text-anchor="middle" class="fe-core-sub">
          53 周 · 两周一档
        </text>
      </svg>
    </figure>
    <ul class="fe-legend">
      {star.map((f) => (
        <li style={`--hue: ${HUE[f.season]}`}>
          <span class="fe-swatch" aria-hidden="true" />
          <strong>{inner(f.name['zh-Hans'])}</strong>
          <small>第 {ranges(f.id)} 周</small>
        </li>
      ))}
      <li class="fe-legend-plain">
        <span class="fe-swatch" aria-hidden="true" />
        <strong>平时</strong>
        <small>轮换编号 1 → 2 → 3 循环</small>
      </li>
    </ul>
  </section>

  <section class="s-section">
    <h2>祭典</h2>
    <div class="fe-cards">
      {festivals.map((f) => (
        <article class="fe-card" style={`--hue: ${HUE[f.season]}`}>
          <header>
            <small>{f.kind}</small>
            <h3>{inner(f.name['zh-Hans'])}</h3>
            <span class="fe-en">{f.name.en}</span>
          </header>
          <dl>
            {f.weeks && (
              <>
                <dt>日程</dt>
                <dd>第 {f.weeks} 周</dd>
              </>
            )}
            {f.kind === '月辰祭' && (
              <>
                <dt>蒸气机关</dt>
                <dd>
                  <a href="/world/steamworks/">「{STEAM_TABLE[f.season]}」奖励表</a>
                </dd>
              </>
            )}
          </dl>
          {f.tickets.length > 0 && (
            <ul class="fe-tickets">
              {f.tickets.map((t) => (
                <li>
                  <img src={itemIconUrl(t.item)} alt="" width="26" height="26" loading="lazy" />
                  <div>
                    <strong>{t.item.name['zh-Hans']}</strong>
                    {t.series.length > 0 && (
                      <small>
                        可生产：
                        <a href="/world/layered-armor/">{t.series.join('、')}</a>
                      </small>
                    )}
                  </div>
                </li>
              ))}
            </ul>
          )}
        </article>
      ))}
    </div>
  </section>

  <p class="s-note">
    数据来源：<code>common/network/scheduleMap.ysm</code>（一年 53 周，每周 4
    个整数：祭典编号、未知、轮换编号、未知）， 祭典名 <code>panel_tutorial_cat</code>。祭典编号 1–5
    与季节的对应是由所在的周推出的，并与蒸气机关的 Spring / Summer / Autumn / Winter / Memorial
    奖励表、文本键名 SEV_H / N / A / F / 1 一致。这张表只有星辰祭（含秋季）； PC
    版各次祭典的实际日期由线上公告决定，不一定与此表相同。周与公历日期的对应未确认，月份刻度按 365
    天均分估算；「轮换编号」与第 4 个整数的含义未确认。
  </p>
</SiteLayout>

<style>
  .fe-wheel {
    display: grid;
    grid-template-columns: minmax(0, 460px) minmax(0, 1fr);
    gap: var(--space-5, 32px);
    align-items: center;
    margin-bottom: var(--space-5, 32px);
  }

  .fe-wheel figure {
    margin: 0;
  }

  .fe-wheel svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .fe-core {
    fill: color-mix(in oklab, var(--c-surface) 70%, transparent);
    stroke: var(--c-line);
  }

  .fe-core-title {
    fill: var(--c-text);
    font-size: 26px;
    font-weight: 700;
    letter-spacing: 0.1em;
  }

  .fe-core-sub {
    fill: var(--c-text-3);
    font-size: 12px;
  }

  .fe-month path {
    stroke: var(--c-line-strong);
    stroke-width: 1;
  }

  .fe-month text {
    fill: var(--c-text-3);
    font-size: 11px;
  }

  .fe-seg {
    fill: color-mix(in oklab, var(--c-text-3) 18%, transparent);
    transition:
      fill 0.2s ease,
      transform 0.2s ease;
    transform-origin: 210px 210px;
  }

  .fe-seg--fes {
    fill: var(--hue);
    animation: fe-in 0.6s ease both;
    animation-delay: calc(var(--i) * 12ms);
  }

  .fe-seg:hover {
    fill: color-mix(in oklab, var(--hue, var(--c-text-2)) 80%, white);
    transform: scale(1.025);
  }

  @keyframes fe-in {
    from {
      opacity: 0;
      transform: scale(0.94);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fe-seg,
    .fe-seg--fes {
      animation: none;
      transition: none;
    }

    .fe-seg:hover {
      transform: none;
    }
  }

  .fe-legend {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .fe-legend li {
    display: grid;
    grid-template-columns: 14px auto minmax(0, 1fr);
    gap: var(--space-2) var(--space-3);
    align-items: baseline;
  }

  .fe-swatch {
    width: 14px;
    height: 14px;
    border-radius: 4px;
    background: var(--hue);
    align-self: center;
  }

  .fe-legend-plain .fe-swatch {
    background: color-mix(in oklab, var(--c-text-3) 30%, transparent);
  }

  .fe-legend small {
    color: var(--c-text-3);
    font-family: var(--font-num);
    font-size: var(--text-xs);
  }

  .fe-cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: var(--space-3);
    align-items: start;
  }

  .fe-card {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-4);
    border-radius: var(--radius);
    background:
      radial-gradient(120% 90% at 100% 0%, color-mix(in oklab, var(--hue) 22%, transparent), transparent 60%),
      var(--c-surface);
    box-shadow:
      inset 0 0 0 1px var(--c-line),
      inset 3px 0 0 var(--hue);
  }

  .fe-card header {
    display: grid;
  }

  .fe-card header small {
    color: var(--c-text-3);
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
  }

  .fe-card h3 {
    margin: 0;
    font-size: var(--text-lg, 1.25rem);
  }

  .fe-en {
    color: var(--c-text-3);
    font-size: var(--text-xs);
  }

  .fe-card dl {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 4px var(--space-3);
    margin: 0;
    font-size: var(--text-sm);
  }

  .fe-card dt {
    color: var(--c-text-3);
  }

  .fe-card dd {
    margin: 0;
  }

  .fe-tickets {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .fe-tickets li {
    display: grid;
    grid-template-columns: 26px minmax(0, 1fr);
    gap: var(--space-2);
    align-items: start;
    font-size: var(--text-sm);
  }

  .fe-tickets div {
    display: grid;
  }

  .fe-tickets small {
    color: var(--c-text-2);
    font-size: var(--text-xs);
  }

  @media (max-width: 760px) {
    .fe-wheel {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
