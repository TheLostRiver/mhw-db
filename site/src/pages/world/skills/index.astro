---
import GameText from '../../../components/site/GameText.astro';
import { plainText } from '../../../lib/world/text';
import SiteLayout from '../../../layouts/SiteLayout.astro';
import FilterBox from '../../../components/site/FilterBox.astro';
import { loadCharms, loadDecorations, loadSkills } from '../../../data/world/load';
import type { Skill } from '../../../data/world/schema';
import { skillIconUrl } from '../../../lib/world/encyclopedia';

const skills = loadSkills();
const decos = loadDecorations();
const charms = loadCharms();
const byId = new Map(skills.map((s) => [s.id, s]));
const sources = (s: Skill) => ({
  decos: decos.filter((d) => d.skills.some((x) => x.id === s.id)),
  charms: charms.filter((c) => c.skills.some((x) => x.id === s.id)).length,
});
const groups = [
  { title: '技能', list: skills.filter((s) => !s.setBonus) },
  { title: '套装技能', list: skills.filter((s) => s.setBonus) },
];
const lines = (t?: string) => plainText(t).replace(/\n/g, '');
---

<SiteLayout
  title="技能"
  current="encyclopedia"
  description="怪物猎人：世界 冰原 技能一览：每级效果、上限、来源饰品"
  wide
>
  <nav class="s-crumbs" aria-label="位置">
    <a href="/world/encyclopedia/">百科</a>
    <span>技能</span>
  </nav>
  <div class="s-head">
    <h1>
      技能 <span class="b-label">{skills.length} 个</span>
    </h1>
    <p>每个技能的各级效果（游戏内说明文本）、上限（括号里为极意等解放前的上限），以及带这个技能的饰品。</p>
  </div>
  <FilterBox label="按技能名或效果筛选" placeholder="按技能名或效果说明筛选" />
  {groups.map((g) => (
    <section class="s-section" data-filter-section>
      <h2>
        {g.title} <span class="b-label">{g.list.length} 个</span>
      </h2>
      <div class="sk-list">
        {g.list.map((s) => {
          const src = sources(s);
          const text = [
            s.name['zh-Hans'],
            s.name.ja,
            s.name.en,
            lines(s.desc?.['zh-Hans']),
            ...s.levels.map((l) => `${l.name?.['zh-Hans'] ?? ''} ${lines(l.desc?.['zh-Hans'])}`),
          ]
            .join(' ')
            .toLowerCase();
          return (
            <article class="sk-card" data-filter-row data-text={text} id={`skill-${s.id}`}>
              <header>
                <img src={skillIconUrl(s.iconColor)} alt="" width="28" height="28" loading="lazy" />
                <h3>{s.name['zh-Hans']}</h3>
                <span class="b-label">
                  {s.setBonus
                    ? '套装'
                    : `上限 Lv${s.maxLevel}${s.maxLevel !== s.baseMaxLevel ? `（${s.baseMaxLevel}）` : ''}`}
                </span>
              </header>
              {s.desc?.['zh-Hans'] && (
                <p class="sk-desc">
                  <GameText text={s.desc['zh-Hans']} />
                </p>
              )}
              <ol class="sk-levels">
                {s.levels.map((l) => (
                  <li>
                    <span class="sk-lv">{s.setBonus ? `${l.level} 件` : `Lv${l.level}`}</span>
                    <span>
                      {l.name?.['zh-Hans'] && <strong>{l.name['zh-Hans']}：</strong>}
                      <GameText text={l.desc?.['zh-Hans']} />
                      {l.unlockedBy?.map((u) => (
                        <em class="sk-unlock">
                          需 {byId.get(u.skill)?.name['zh-Hans'] ?? `#${u.skill}`} {u.level} 件
                        </em>
                      ))}
                    </span>
                  </li>
                ))}
              </ol>
              {(src.decos.length > 0 || src.charms > 0) && (
                <p class="sk-src">
                  {src.decos.length > 0 && <>饰品：{src.decos.map((d) => d.name['zh-Hans']).join('、')}</>}
                  {src.charms > 0 && (
                    <>
                      {src.decos.length > 0 && '；'}
                      <a href="/world/charms/">{src.charms} 个护石</a>
                    </>
                  )}
                </p>
              )}
            </article>
          );
        })}
      </div>
    </section>
  ))}
  <p class="s-note">
    数据来源：<code>common/equip/skill_data.skl_dat</code>、<code>skill_point_data.skl_pt_dat</code>{' '}
    与技能说明文本（<code>common/text/vfont/skill*</code>）。
  </p>
</SiteLayout>

<style>
  .sk-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: var(--space-3);
  }

  .sk-card {
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius);
    background: var(--c-surface);
    box-shadow: inset 0 0 0 1px var(--c-line);
  }

  .sk-card header {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-2);
  }

  .sk-card h3 {
    margin-right: auto;
    font-size: var(--text-md);
    font-weight: 700;
  }

  .sk-desc {
    margin-bottom: var(--space-2);
    color: var(--c-text-2);
    font-size: var(--text-sm);
  }

  .sk-levels {
    display: grid;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-sm);
  }

  .sk-levels li {
    display: grid;
    grid-template-columns: 3.2em minmax(0, 1fr);
    gap: var(--space-2);
  }

  .sk-lv {
    color: var(--c-text-3);
    font-family: var(--font-num);
  }

  .sk-unlock {
    margin-left: var(--space-2);
    color: var(--c-text-3);
    font-style: normal;
  }

  .sk-src {
    margin-top: var(--space-2);
    padding-top: var(--space-2);
    border-top: 1px solid var(--c-line);
    color: var(--c-text-2);
    font-size: var(--text-xs);
  }
</style>
