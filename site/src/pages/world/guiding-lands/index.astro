---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import { loadGuidingLands, loadMonsters, loadQuests } from '../../../data/world/load';
import type { GuidingLands } from '../../../data/world/schema-guiding';
import { monsterIconUrl, monsterName } from '../../../lib/world/monsters';

const { regions, monsters } = loadGuidingLands();
const byKey = new Map(loadMonsters().map((m) => [m.key, m]));
const questName = new Map(loadQuests().quests.map((q) => [q.id, q.name['zh-Hans']]));
type Key = GuidingLands['regions'][number]['key'];
const HUE: Record<Key, string> = {
  forest: '#5cc98f',
  wildspire: '#d9a441',
  coral: '#e98bb0',
  rotted: '#b07cc6',
  volcanic: '#e0603c',
  tundra: '#8fd3ff',
};
const LEVELS = [1, 2, 3, 4, 5, 6, 7];

const sections = regions.map((region, r) => {
  const rows = monsters
    .filter((m) => m.habitat[r])
    .map((m) => {
      const w = m.weights[r]!;
      return { m, mon: byKey.get(m.monster), w, first: w.findIndex((x) => x > 0) };
    })
    .sort((a, b) => a.first - b.first || b.m.habitat[r]! - a.m.habitat[r]! || a.m.gameId - b.m.gameId);
  const totals = LEVELS.map((_, l) => rows.reduce((s, x) => s + x.w[l]!, 0));
  return { region, r, rows, totals };
});
const pct = (w: number, total: number) => (total ? Math.round((w / total) * 1000) / 10 : 0);
---

<SiteLayout
  title="聚魔之地"
  current="encyclopedia"
  description="怪物猎人：世界 冰原 聚魔之地：六个地带在各地带等级下出现的怪物与出现权重"
  wide
>
  <nav class="s-crumbs" aria-label="位置">
    <a href="/world/encyclopedia/">百科</a>
    <span>聚魔之地</span>
  </nav>
  <div class="s-head">
    <h1>
      聚魔之地 <span class="b-label">{monsters.length} 种怪物 · 6 个地带</span>
    </h1>
    <p>
      每个地带的等级（1–7）决定会出现哪些怪物。下面按地带列出各等级的候选怪物与出现权重：格子里是数据里的权重，
      底色越深，在这一级的候选里占比越大。
    </p>
  </div>

  <ul class="gl-regions">
    {sections.map(({ region, r, rows }) => (
      <li style={`--hue: ${HUE[region.key]}`}>
        <a href={`#${region.key}`}>
          <span class="gl-glow" aria-hidden="true" />
          <strong>{region.name['zh-Hans']}</strong>
          <small>{region.name.en}</small>
          <span class="gl-icons">
            {rows
              .filter((x) => x.m.habitat[r] === 2)
              .slice(0, 6)
              .map((x) => {
                const icon = x.mon && monsterIconUrl(x.mon);
                return icon ? (
                  <img
                    src={icon}
                    alt=""
                    width="28"
                    height="28"
                    loading="lazy"
                    title={x.mon && monsterName(x.mon)}
                  />
                ) : null;
              })}
          </span>
          <b>{rows.length} 种</b>
        </a>
      </li>
    ))}
  </ul>

  {sections.map(({ region, r, rows, totals }) => (
    <section class="s-section gl-sec" id={region.key} style={`--hue: ${HUE[region.key]}`}>
      <h2>
        {region.name['zh-Hans']} <small>{rows.length} 种</small>
      </h2>
      <div class="s-table-wrap">
        <table class="s-table gl-table">
          <thead>
            <tr>
              <th class="s-left">怪物</th>
              {LEVELS.map((l) => (
                <th>Lv{l}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {rows.map(({ m, mon, w }) => {
              const icon = mon && monsterIconUrl(mon);
              return (
                <tr>
                  <th class="s-left gl-mon" scope="row">
                    <a href={`/world/monsters/${m.monster}/`}>
                      {icon && <img src={icon} alt="" width="28" height="28" loading="lazy" />}
                      <span>{mon ? monsterName(mon) : m.monster}</span>
                    </a>
                    {m.habitat[r] === 2 && <span class="gl-main">主</span>}
                    {m.unlockQuest != null && (
                      <a
                        class="gl-unlock"
                        href={`/world/quests/${m.unlockQuest}/`}
                        title="出现前需要完成的任务（推断）"
                      >
                        需「{questName.get(m.unlockQuest) ?? m.unlockQuest}」
                      </a>
                    )}
                  </th>
                  {w.map((x, l) => {
                    const p = pct(x, totals[l]!);
                    return (
                      <td
                        class:list={['s-num gl-cell', { 's-dim': !x }]}
                        style={x ? `--share: ${Math.min(1, p / 40)}` : undefined}
                        title={x ? `Lv${l + 1}：权重 ${x}（本级合计 ${totals[l]}，约 ${p}%）` : undefined}
                      >
                        {x || '·'}
                      </td>
                    );
                  })}
                </tr>
              );
            })}
          </tbody>
          <tfoot>
            <tr>
              <th class="s-left">合计</th>
              {totals.map((t) => (
                <td class="s-num">{t}</td>
              ))}
            </tr>
          </tfoot>
        </table>
      </div>
    </section>
  ))}

  <p class="s-note">
    数据来源：<code>quest/enemy/endContentsEmData.ecem</code>（每只怪物一条，按 gameId 排），地带名
    <code>cm_start_menu</code>。每个地带一个栖息标记（0 / 1 / 2）与 7
    个等级的权重；标记与「有无权重」逐条一致， 「主」是标记为 2
    的地带（火龙在森林、雌火龙在荒地、冰呪龙在冰雪……与游戏内的主要栖息地一致）。 「约 x%」是按「权重 ÷
    本级合计」换算的，游戏是否就这样抽选未确认；同时出现几只、历战个体如何出现也不在这张表里。
    「需完成的任务」是按记录里的任务编号对应到任务表，推断为出现条件。黑狼鸟 / 战痕黑狼鸟另有一组权重
    （没有战痕黑狼鸟、黑狼鸟延伸到 Lv6–7），推断为解锁战痕黑狼鸟之前使用。
  </p>
</SiteLayout>

<style>
  .gl-regions {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 200px), 1fr));
    gap: var(--space-3);
    margin: 0 0 var(--space-5, 32px);
    padding: 0;
    list-style: none;
  }

  .gl-regions a {
    position: relative;
    display: grid;
    gap: 4px;
    overflow: hidden;
    padding: var(--space-4);
    border-radius: var(--radius);
    background: var(--c-surface);
    box-shadow:
      inset 0 0 0 1px var(--c-line),
      inset 0 -3px 0 var(--hue);
    color: inherit;
    text-decoration: none;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .gl-regions a:hover,
  .gl-regions a:focus-visible {
    transform: translateY(-2px);
    box-shadow:
      inset 0 0 0 1px color-mix(in oklab, var(--hue) 60%, transparent),
      inset 0 -3px 0 var(--hue);
  }

  .gl-glow {
    position: absolute;
    inset: -40% -30% auto auto;
    width: 160px;
    height: 160px;
    border-radius: 50%;
    background: radial-gradient(closest-side, color-mix(in oklab, var(--hue) 35%, transparent), transparent);
    pointer-events: none;
  }

  .gl-regions strong {
    font-size: var(--text-lg, 1.2rem);
  }

  .gl-regions small {
    color: var(--c-text-3);
    font-size: var(--text-xs);
  }

  .gl-regions b {
    color: var(--c-text-2);
    font-family: var(--font-num);
    font-size: var(--text-xs);
    font-weight: 500;
  }

  .gl-icons {
    display: flex;
    gap: 2px;
    min-height: 28px;
    margin-top: var(--space-2);
  }

  @media (prefers-reduced-motion: reduce) {
    .gl-regions a {
      transition: none;
    }

    .gl-regions a:hover {
      transform: none;
    }
  }

  .gl-sec {
    scroll-margin-top: 72px;
  }

  .gl-sec h2 {
    display: flex;
    gap: var(--space-2);
    align-items: baseline;
  }

  .gl-sec h2::before {
    content: '';
    width: 12px;
    height: 12px;
    border-radius: 3px;
    background: var(--hue);
    align-self: center;
  }

  .gl-sec h2 small {
    color: var(--c-text-3);
    font-family: var(--font-num);
    font-size: var(--text-xs);
    font-weight: 400;
  }

  .gl-mon {
    min-width: 210px;
    font-weight: 400;
  }

  .gl-mon > a:first-child {
    display: inline-flex;
    gap: var(--space-2);
    align-items: center;
    color: inherit;
    text-decoration: none;
  }

  .gl-mon > a:first-child:hover span {
    color: var(--c-accent);
  }

  .gl-main {
    margin-left: 6px;
    padding: 0 5px;
    border-radius: 4px;
    background: color-mix(in oklab, var(--hue) 28%, transparent);
    color: var(--c-text);
    font-size: var(--text-xs);
  }

  .gl-unlock {
    display: block;
    margin-left: 36px;
    color: var(--c-text-3);
    font-size: var(--text-xs);
  }

  .gl-cell {
    min-width: 52px;
    background: color-mix(in oklab, var(--hue) calc(var(--share, 0) * 70%), transparent);
  }

  .gl-table tfoot th,
  .gl-table tfoot td {
    color: var(--c-text-3);
    font-size: var(--text-xs);
  }
</style>
